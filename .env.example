# ──────────────────────────────────────────────────────────────────────────────
# BitRot — environment variables reference
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is already in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (client-side, safe to expose) ────────────────────────────────────
# Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co

# Dashboard → Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# ── Supabase (server-side only — NEVER expose to the browser) ────────────────
# Dashboard → Settings → API → service_role secret key
# Used only by the Vercel Cron route handler (app/api/cron/process-decay).
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# ── Cron security secret ──────────────────────────────────────────────────────
# A random secret shared between the cron caller and the handler.
# Generate one with: openssl rand -base64 32
#
# Vercel Cron:   set in Vercel Dashboard → Project → Settings → Env Vars
#                Vercel injects it automatically as: Authorization: Bearer <value>
#
# Supabase Edge: set in Dashboard → Edge Functions → Secrets as DECAY_CRON_SECRET
#                The scheduler injects it automatically into each invocation.
CRON_SECRET=<generate-with-openssl-rand-base64-32>

# Same value, different name — used inside the Edge Function (Deno reads
# DECAY_CRON_SECRET, while the Next.js route reads CRON_SECRET).
# Set this in Supabase Dashboard → Edge Functions → Secrets.
DECAY_CRON_SECRET=<same-value-as-CRON_SECRET>
